{
	"loss_function": "binarycrossentropy",
	"layers": [
		{"type": "Dense", "units": 16, "activation": "relu", "weights_initializer": {"type": "heUniform", "params": {"n_inputs": 1}}},
		{"type": "Dense", "units": 32, "activation": "relu", "weights_initializer": {"type": "heUniform", "params": {"n_inputs": 16}}},
		{"type": "Dense", "units": 32, "activation": "tanh", "weights_initializer": {"type": "LeCun", "params": {"n_inputs": 32}}},
		{"type": "Dense", "units": 1, "activation": "sigmoid", "weights_initializer": {"type": "LeCun", "params": {"n_inputs": 32}}}
	],
	"epochs": 1001,
	"batch_size": 16,
	"optimizer": {"type": "adam", "params": {"learning_rate": 0.01}},
	"early_stopping": {"patience": 5, "min_delta": 0.001, "monitor" : "val_loss"}
}
